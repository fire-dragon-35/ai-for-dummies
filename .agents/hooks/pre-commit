#!/bin/sh
# shellcheck disable=SC1091
. "$(dirname "$0")/common.sh"
started=$(date +%s)
status=0
report() {
  if [ -z "$3" ]; then
    mark pass "$1" "$2"
  else
    mark fail "$1" "$2"
    printf '%s\n' "$3" | sed '/^$/d; s/^/      /' >&2
    status=1
  fi
}
reviewed=
for d in $(git diff --cached --name-only -- .agents/tests/ | grep '^\.agents/tests/[^/]*/' | cut -d/ -f1-3 | sort -u); do
  [ -n "$(git ls-files -- "$d")" ] || continue
  if [ "$(git show ":$d/reviewed" 2>/dev/null)" != "$(sh "$(dirname "$0")/fingerprint.sh" --staged "$d")" ]; then
    reviewed="$reviewed$d changed since its last review. Have a subagent run the review-tests skill on it
"
  fi
done
staged=$(mktemp -d) || exit 1
trap 'rm -rf "$staged"' EXIT
set --
set -f
IFS='
'
checked=0
scripts=0
long=
comments=
for f in $(git -c core.quotePath=false diff --cached --name-only --diff-filter=AM | grep -v '^\.agents/skills/'); do
  mkdir -p "$staged/$(dirname "$f")" && git show ":$f" > "$staged/$f" || exit 1
  checked=$((checked + 1))
  if [ "$(awk 'END { print NR }' "$staged/$f")" -gt 400 ]; then
    long="$long$f has more than 400 lines. Keep each file under ~200 lines, never over 400
"
  fi
  case $f in
    *.sh | .agents/hooks/*)
      module=0
      set -- "$@" "$f"
      ;;
    *.mjs) module=1 ;;
    *) continue ;;
  esac
  scripts=$((scripts + 1))
  if awk -v module="$module" 'NR == 1 && /^#!/ { next } !module && /^[ \t]*# shellcheck / { next } !module && /^[ \t]*#/ { found = 1 } module && /^[ \t]*(\/\/|\/\*)/ { found = 1 } END { exit !found }' "$staged/$f"; then
    comments="$comments$f has comment lines. No comments: clean code should be self-explanatory
"
  fi
done
findings=
if [ $# -gt 0 ] && ! findings=$(cd "$staged" && run_shellcheck "$@" 2>&1); then
  findings="${findings:-shellcheck failed}"
fi
echo "pre-commit" >&2
reviewed_detail="up to date"
[ -z "$reviewed" ] || reviewed_detail="needs review"
report "reviewed tests" "$reviewed_detail" "$reviewed"
report "no comments" "$scripts script files" "$comments"
report "line limit" "$checked files" "$long"
report "shellcheck" "$# shell files" "$findings"
log_duration checks "$started"
if [ -s .agents/backlog.md ]; then
  echo "backlog ($(grep -c . .agents/backlog.md))" >&2
  sed '/^$/d; s/^/  /' .agents/backlog.md >&2
fi
exit "$status"
